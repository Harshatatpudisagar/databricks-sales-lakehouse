{
  "datasets": [
    {
      "name": "4a76cfbc",
      "displayName": "customer_sales_gold",
      "config": {
        "version": "1.1",
        "source": "harshadatabricksdebt.default.customer_sales_gold",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ]
      }
    },
    {
      "name": "f2493f73",
      "displayName": "Customer Sales Performance Summary",
      "queryLines": [
        "SELECT\r\n",
        "    customer_name,\r\n",
        "    order_count,\r\n",
        "    total_sales,\r\n",
        "    average_order_value\r\n",
        "FROM harshadatabricksdebt.default.customer_sales_gold\r\n",
        "ORDER BY total_sales DESC;"
      ]
    },
    {
      "name": "ed6a211d",
      "displayName": "Aggregated Customer Sales Total Revenue Summary",
      "queryLines": [
        "SELECT\r\n",
        "    SUM(total_sales) AS total_revenue\r\n",
        "FROM harshadatabricksdebt.default.customer_sales_gold;"
      ]
    },
    {
      "name": "d3635ed0",
      "displayName": "Total Sales Order Summary",
      "queryLines": [
        "SELECT\r\n",
        "    SUM(order_count) AS total_orders\r\n",
        "FROM harshadatabricksdebt.default.customer_sales_gold;"
      ]
    },
    {
      "name": "e9ba12d4",
      "displayName": "Customer Count Summary From Sales Data",
      "queryLines": [
        "SELECT\r\n",
        "    COUNT(*) AS total_customers\r\n",
        "FROM harshadatabricksdebt.default.customer_sales_gold;"
      ]
    },
    {
      "name": "59bcf72e",
      "displayName": "Average Value Per Customer Order Calculation",
      "queryLines": [
        "SELECT\r\n",
        "    SUM(total_sales) / SUM(order_count) AS average_order_value\r\n",
        "FROM harshadatabricksdebt.default.customer_sales_gold;"
      ]
    }
  ],
